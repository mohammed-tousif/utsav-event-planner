# Copy this file to .env and fill in your own values. Never commit .env.

# Google Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Model used for plans and revisions, and comma-separated fallbacks tried in
# order if the primary model is rate-limited, unavailable or returns bad output.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.8-flash

# Thinking effort: MINIMAL, LOW, MEDIUM, HIGH or OFF. LOW keeps replies fast.
GEMINI_THINKING_LEVEL=LOW

# Milliseconds before an AI call is abandoned.
GEMINI_TIMEOUT_MS=40000

# "gemini" (default) or "sample". Sample returns fixed, clearly labelled
# placeholder content and never calls an AI. Without a key, development
# falls back to sample data; production reports AI as unavailable.
AI_PROVIDER=gemini

# AI requests allowed per visitor IP per window.
RATE_LIMIT_MAX_AI=12
RATE_LIMIT_WINDOW_MS=900000

PORT=8080
